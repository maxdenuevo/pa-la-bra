---
const { tipo, class: clase = '' } = Astro.props;
const n = '#111111';
const am = '#f7b801';
const bl = '#ffffff';
const ve = '#2a7d3e';
const rayos = Array.from({ length: 12 }, (_, i) => i * 30);
const granos = [0, 1, 2, 3, 4];
---
{tipo === 'sol' && (
  <svg class={clase} viewBox="0 0 200 200" aria-hidden="true">
    <g filter="url(#aspero)">
      {rayos.map((a) => (
        <polygon points="100,4 112,52 88,52" fill={am} stroke={n} stroke-width="6" stroke-linejoin="round" transform={`rotate(${a} 100 100)`} />
      ))}
      <circle cx="100" cy="100" r="50" fill={am} stroke={n} stroke-width="8" />
    </g>
  </svg>
)}
{tipo === 'espiga' && (
  <svg class={clase} viewBox="0 0 80 240" aria-hidden="true">
    <g filter="url(#aspero)" stroke={n} stroke-width="6" stroke-linejoin="round">
      <path d="M40 236 L40 30" fill="none" stroke-linecap="round" />
      {granos.map((k) => (
        <>
          <ellipse cx="24" cy={60 + k * 32} rx="14" ry="24" fill={am} transform={`rotate(-28 24 ${60 + k * 32})`} />
          <ellipse cx="56" cy={60 + k * 32} rx="14" ry="24" fill={am} transform={`rotate(28 56 ${60 + k * 32})`} />
        </>
      ))}
      <ellipse cx="40" cy="30" rx="13" ry="26" fill={am} />
      <path d="M40 200 C 18 190 8 172 6 150 C 26 156 38 172 40 200 Z" fill={ve} />
    </g>
  </svg>
)}
{tipo === 'flor' && (
  <svg class={clase} viewBox="0 0 200 200" aria-hidden="true">
    <g filter="url(#aspero)" stroke={n} stroke-width="7">
      {[0, 60, 120, 180, 240, 300].map((a) => (
        <ellipse cx="100" cy="52" rx="30" ry="44" fill={bl} transform={`rotate(${a} 100 100)`} />
      ))}
      <circle cx="100" cy="100" r="32" fill={am} />
    </g>
  </svg>
)}
{tipo === 'mano' && (
  <svg class={clase} viewBox="0 0 200 240" aria-hidden="true">
    <g filter="url(#aspero)" fill={am} stroke={n} stroke-width="8" stroke-linejoin="round">
      <rect x="44" y="20" width="26" height="110" rx="13" />
      <rect x="74" y="6" width="26" height="124" rx="13" />
      <rect x="104" y="12" width="26" height="118" rx="13" />
      <rect x="134" y="34" width="24" height="100" rx="12" />
      <rect x="6" y="104" width="26" height="80" rx="13" transform="rotate(-38 19 144)" />
      <path d="M40 104 H160 V170 C160 210 136 234 100 234 C64 234 40 210 40 170 Z" />
    </g>
  </svg>
)}
